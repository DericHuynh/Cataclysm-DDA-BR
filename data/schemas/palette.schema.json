{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapgenPaletteDef",
  "description": "A mapgen palette from JSON type `\"palette\"`.\n\nPalettes are shared symbol→entity mappings referenced by mapgen definitions. Multiple palette IDs can compose (via the `palettes` array).",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "flags": {
      "description": "General flags.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "furniture": {
      "description": "Symbol → furniture ID.  Same format as terrain.",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    },
    "id": {
      "description": "Unique palette identifier.",
      "allOf": [
        {
          "$ref": "#/definitions/DefId"
        }
      ]
    },
    "items": {
      "description": "Symbol → item group / spawn entry. Value is typically `{\"item\": \"group_id\", \"chance\": N}` or an array of such objects.",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    },
    "liquids": {
      "description": "Symbol → liquid placement data.",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    },
    "monster": {
      "description": "Symbol → monster spawn entry.",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    },
    "palettes": {
      "description": "Other palettes to compose into this one (bottom-to-top layering).",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/PaletteRef"
      }
    },
    "parameters": {
      "description": "Parameter definitions for parameterized palettes.",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    },
    "terrain": {
      "description": "Symbol → terrain ID. Value can be a string (`\"t_floor\"`) or an array of `[id, weight]` tuples for weighted random selection.",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    },
    "toilets": {
      "description": "Symbol → toilet marker (value is typically `{}`).",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    },
    "vendingmachines": {
      "description": "Symbol → vending machine config.",
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/RawValue"
      }
    }
  },
  "definitions": {
    "DefId": {
      "type": "string"
    },
    "PaletteRef": {
      "description": "A reference to a palette — can be a plain string ID, a parameter, or a distribution of weighted options.",
      "anyOf": [
        {
          "description": "Simple: `\"domestic_general_palette\"`.",
          "type": "string"
        },
        {
          "description": "Parameterized: `{\"param\": \"food_type\"}`.",
          "type": "object",
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "type": "string"
            }
          }
        },
        {
          "description": "Object with palette key: `{\"palette\": \"roof_palette\"}`.",
          "type": "object",
          "required": [
            "palette"
          ],
          "properties": {
            "palette": {
              "type": "string"
            }
          }
        },
        {
          "description": "Weighted distribution: `{\"distribution\": [[\"a\", 2], [\"b\", 1]]}`.",
          "type": "object",
          "required": [
            "distribution"
          ],
          "properties": {
            "distribution": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RawValue"
              }
            }
          }
        }
      ]
    },
    "RawValue": {
      "description": "A flexible JSON-like value for catch-all fields where CDDA data can be a string, number, boolean, array, or object. This replaces `serde_json::Value` to avoid pulling in the serde_json dependency for type definitions.",
      "anyOf": [
        {
          "description": "A string value.",
          "type": "string"
        },
        {
          "description": "A numeric value (integer or float).",
          "type": "number",
          "format": "double"
        },
        {
          "description": "A boolean value.",
          "type": "boolean"
        },
        {
          "description": "An array of values.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        {
          "description": "An object/map of string keys to values.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RawValue"
          }
        }
      ]
    }
  }
}