{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProficiencyDef",
  "description": "A proficiency definition from JSON type `\"proficiency\"`.\n\nDefines a learnable proficiency (e.g. \"Parkour Expert\", \"Archery\").",
  "type": "object",
  "required": [
    "category",
    "id",
    "name"
  ],
  "properties": {
    "abstract_": {
      "description": "Abstract flag.",
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "can_learn": {
      "description": "Whether the proficiency can be learned.",
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "category": {
      "description": "Category identifier (e.g. \"prof_athletics\").",
      "type": "string"
    },
    "copy_from": {
      "description": "Base definition to copy fields from.",
      "type": [
        "string",
        "null"
      ]
    },
    "default_skill": {
      "description": "Default skill used for learning.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "default_skill_level": {
      "description": "Default skill level required.",
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "description": {
      "description": "Description text.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/LocalizedString"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "Unique identifier (e.g. \"prof_parkour\").",
      "allOf": [
        {
          "$ref": "#/definitions/DefId"
        }
      ]
    },
    "name": {
      "description": "Display name (e.g. \"Parkour Expert\").",
      "allOf": [
        {
          "$ref": "#/definitions/LocalizedString"
        }
      ]
    },
    "required_proficiencies": {
      "description": "Required proficiencies.",
      "default": null,
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "time_to_learn": {
      "description": "Estimated time to learn.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "DefId": {
      "type": "string"
    },
    "LocalizedString": {
      "description": "A localized string that may contain translations for multiple languages.\n\nIn CDDA JSON, this appears as: ```json { \"str\": \"name\", \"//~\": \"context\" } { \"str_sp\": \"name\" }           // same for singular & plural { \"str_pl\": \"names\" }          // explicit plural ``` Or as a plain string `\"name\"`.\n\nFor Stage 1 we store the raw English text. Full i18n support (extracting translations) is deferred.",
      "anyOf": [
        {
          "description": "A plain, non-localized string.",
          "type": "string"
        },
        {
          "description": "A localized object with optional plural and context.",
          "type": "object",
          "properties": {
            "context": {
              "type": [
                "string",
                "null"
              ]
            },
            "str": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "str_pl": {
              "type": [
                "string",
                "null"
              ]
            },
            "str_sp": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}