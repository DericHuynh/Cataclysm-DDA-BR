          ],
          "maxItems": 2,
          "minItems": 2
        },
        {
          "description": "With charge requirement: `[\"item_id\", required_count, charge_count]`.",
          "type": "array",
          "items": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          ],
          "maxItems": 3,
          "minItems": 3
        },
        {
          "description": "With a string flag (e.g. \"LIST\"): `[\"item_id\", count, \"FLAG\"]`.",
          "type": "array",
          "items": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "int32"
            },
            {
              "type": "string"
            }
          ],
          "maxItems": 3,
          "minItems": 3
        },
        {
          "description": "Object form.",
          "allOf": [
            {
              "$ref": "#/definitions/ToolOptionObj"
            }
          ]
        }
      ]
    },
