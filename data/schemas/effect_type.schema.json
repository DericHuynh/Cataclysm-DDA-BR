            "$ref": "#/definitions/RawValue"
          }
        },
        "speed_mod": {
          "description": "Speed modifier.",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        "stamina_mod": {
          "description": "Stamina modifier.",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        "str_mod": {
          "description": "Stat modifiers.",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        "thirst_mod": {
          "description": "Thirst modifier.",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        "toxicity": {
          "description": "Toxicity modifier.",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        "vomit_chance": {
          "description": "Vomit chance.",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        "vomit_tick": {
          "description": "Vomit tick.",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        }
      }
    },
    "EffectNamedValue": {
      "description": "A named value pair for effect names/descriptions per intensity level. Can be either a plain string or an object with `str` and optional context.",
      "anyOf": [
        {
          "description": "Plain string name/description.",
          "type": "string"
        },
        {
          "description": "Object with `str` field and optional translator context.",
          "type": "object",
          "required": [
            "str"
          ],
          "properties": {
            "//~": {
              "description": "Context/translator note (e.g. \"NO_I18N\").",
              "type": [
                "string",
                "null"
              ]
            },
            "str": {
              "description": "The actual string value.",
              "type": "string"
            }
          }
        }
      ]
    },
    "LimbScoreMod": {
      "description": "Limb score modifier — the `\"limb_score_mods\"` field on effects/bionics.",
      "type": "object",
      "required": [
        "limb_score"
      ],
      "properties": {
        "limb_score": {
          "description": "Which score this modifies (e.g. \"balance\", \"reaction\", \"vision\").",
          "type": "string"
        },
        "max": {
          "description": "Maximum value.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "modifier": {
          "description": "Additive modifier (multiplier for the score).",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "resist_modifier": {
          "description": "Resist modifier (how much resist traits affect this).",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "resist_scaling": {
          "description": "Resist scaling factor.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "scaling": {
          "description": "Scaling factor per intensity.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "RawValue": {
      "description": "A flexible JSON-like value for catch-all fields where CDDA data can be a string, number, boolean, array, or object. This replaces `serde_json::Value` to avoid pulling in the serde_json dependency for type definitions.",
      "anyOf": [
        {
          "description": "A string value.",
          "type": "string"
        },
        {
          "description": "A numeric value (integer or float).",
          "type": "number",
          "format": "double"
        },
        {
          "description": "A boolean value.",
          "type": "boolean"
        },
        {
          "description": "An array of values.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        {
          "description": "An object/map of string keys to values.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RawValue"
          }
        }
      ]
    }
  }
}