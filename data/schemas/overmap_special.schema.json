{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OvermapSpecialDef",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "city_distance": {
      "description": "City distance range [min, max].",
      "default": null,
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "city_sizes": {
      "description": "City size range [min, max].",
      "default": null,
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "connections": {
      "description": "Connections to roads/railroads from this special. Each connection specifies a point, terrain, and connection type.",
      "default": null,
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/SpecialConnection"
      }
    },
    "eoc": {
      "description": "Effect-on-condition triggered on placement.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/RawValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "flags": {
      "description": "Flags. CDDA can use a single string or an array of strings.",
      "default": "",
      "allOf": [
        {
          "$ref": "#/definitions/StringOrArray"
        }
      ]
    },
    "id": {
      "description": "Unique identifier.",
      "allOf": [
        {
          "$ref": "#/definitions/DefId"
        }
      ]
    },
    "joins": {
      "description": "Mutable special: join definitions (array of join objects/strings).",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/RawValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "locations": {
      "description": "Locations this special can spawn in. Can be a single string (e.g. `\"forest\"`) or an array of strings.",
      "default": "",
      "allOf": [
        {
          "$ref": "#/definitions/StringOrArray"
        }
      ]
    },
    "name": {
      "description": "Display name.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/LocalizedString"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurrences": {
      "description": "Chance of occurrence.",
      "default": null,
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "overmaps": {
      "description": "Overmap terrains that make up this special. For standard specials: an array of SpecialOmt objects or strings. For mutable specials: an object/map with named overmap entries.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/RawValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "phases": {
      "description": "Mutable special: phases (array of phase objects, each with `rules`).",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/RawValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "description": "Priority for placement ordering (lower = earlier).",
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "root": {
      "description": "Mutable special: name of the root overmap entry in `overmaps`.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "rotate": {
      "description": "Whether rotation is allowed.",
      "default": true,
      "type": "boolean"
    },
    "rotations": {
      "description": "Rotations allowed. CDDA can use a single string or an array of strings.",
      "default": "",
      "allOf": [
        {
          "$ref": "#/definitions/StringOrArray"
        }
      ]
    },
    "spawns": {
      "description": "Monster spawns associated with this special.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/SpecialSpawns"
        },
        {
          "type": "null"
        }
      ]
    },
    "subtype": {
      "description": "Subtype: \"fixed\" (default) or \"mutable\" for procedural placement.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "DefId": {
      "type": "string"
    },
    "LocalizedString": {
      "description": "A localized string that may contain translations for multiple languages.\n\nIn CDDA JSON, this appears as: ```json { \"str\": \"name\", \"//~\": \"context\" } { \"str_sp\": \"name\" }           // same for singular & plural { \"str_pl\": \"names\" }          // explicit plural ``` Or as a plain string `\"name\"`.\n\nFor Stage 1 we store the raw English text. Full i18n support (extracting translations) is deferred.",
      "anyOf": [
        {
          "description": "A plain, non-localized string.",
          "type": "string"
        },
        {
          "description": "A localized object with optional plural and context.",
          "type": "object",
          "properties": {
            "context": {
              "type": [
                "string",
                "null"
              ]
            },
            "str": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "str_pl": {
              "type": [
                "string",
                "null"
              ]
            },
            "str_sp": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "RawValue": {
      "description": "A flexible JSON-like value for catch-all fields where CDDA data can be a string, number, boolean, array, or object. This replaces `serde_json::Value` to avoid pulling in the serde_json dependency for type definitions.",
      "anyOf": [
        {
          "description": "A string value.",
          "type": "string"
        },
        {
          "description": "A numeric value (integer or float).",
          "type": "number",
          "format": "double"
        },
        {
          "description": "A boolean value.",
          "type": "boolean"
        },
        {
          "description": "An array of values.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RawValue"
          }
        },
        {
          "description": "An object/map of string keys to values.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RawValue"
          }
        }
      ]
    },
    "SpecialConnection": {
      "description": "Overmap special definition from JSON type `\"overmap_special\"`.\n\nDefines a special placement of OMTs (e.g. a \"mansion\" that spans multiple tiles). A connection defined within an overmap special (e.g. road connection).",
      "type": "object",
      "required": [
        "point"
      ],
      "properties": {
        "connection": {
          "description": "Connection type ID (e.g. \"local_road\").",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "existing": {
          "description": "Whether the connection already exists at this location.",
          "default": false,
          "type": "boolean"
        },
        "from": {
          "description": "Hint direction from [dx, dy, dz].",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "point": {
          "description": "Position offset from special origin [dx, dy, dz].",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "terrain": {
          "description": "Terrain to place for the connection (e.g. \"road\").",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SpecialSpawns": {
      "description": "Monster spawn configuration within an overmap special.",
      "type": "object",
      "properties": {
        "group": {
          "description": "Monster group to spawn.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "population": {
          "description": "Population range [min, max].",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "radius": {
          "description": "Radius range [min, max].",
          "default": null,
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "maxItems": 2,
          "minItems": 2
        }
      }
    },
    "StringOrArray": {
      "description": "A value that can be a single string or an array of strings.\n\nUsed by `connect_groups`, `connects_to`, `rotates_to`, and similar fields.\n\nExamples: - `\"wall\"` → `Single(\"wall\")` - `[\"wall\", \"fence\"]` → `Multi(vec![\"wall\", \"fence\"])`",
      "anyOf": [
        {
          "description": "Single string value.",
          "type": "string"
        },
        {
          "description": "Array of strings.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    }
  }
}