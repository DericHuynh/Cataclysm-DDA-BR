{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PracticeDef",
  "description": "A practice recipe definition from JSON type `\"practice\"`.\n\nDefines a practice activity that the player can perform to train skills and proficiencies without consuming resources (or with minimal resource use).",
  "type": "object",
  "required": [
    "category",
    "id",
    "name",
    "subcategory",
    "time"
  ],
  "properties": {
    "activity_level": {
      "description": "Activity level required (e.g. \"LIGHT_EXERCISE\", \"MODERATE_EXERCISE\").",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "autolearn": {
      "description": "Autolearn conditions (skill levels at which this is automatically learned).",
      "default": null,
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "items": true
      }
    },
    "category": {
      "description": "Skill category (e.g. \"CC_PRACTICE\").",
      "type": "string"
    },
    "components": {
      "description": "Components required (flexible CDDA format: can be string, nested array, or complex object).",
      "default": null
    },
    "description": {
      "description": "Description text (can be localized).",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/LocalizedString"
        },
        {
          "type": "null"
        }
      ]
    },
    "flags": {
      "description": "Flags for this practice recipe.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "description": "Unique identifier (e.g. \"research_biochemistry\").",
      "allOf": [
        {
          "$ref": "#/definitions/DefId"
        }
      ]
    },
    "name": {
      "description": "Display name (can be localized).",
      "allOf": [
        {
          "$ref": "#/definitions/LocalizedString"
        }
      ]
    },
    "practice_data": {
      "description": "Practice difficulty and skill limit data.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/PracticeData"
        },
        {
          "type": "null"
        }
      ]
    },
    "proficiencies": {
      "description": "Proficiency requirements (e.g. `[{\"proficiency\": \"prof_intro_biology\", \"required\": true}]`).",
      "default": null,
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "skill_used": {
      "description": "Skill used by this practice (e.g. \"chemistry\").",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "subcategory": {
      "description": "Skill subcategory (e.g. \"CSC_PRACTICE_SCIENCE\").",
      "type": "string"
    },
    "time": {
      "description": "Time required to complete the practice (e.g. \"1 h\").",
      "type": "string"
    },
    "tools": {
      "description": "Tools required (flexible CDDA format: can be string, nested array, or complex object).",
      "default": null
    }
  },
  "definitions": {
    "DefId": {
      "type": "string"
    },
    "LocalizedString": {
      "description": "A localized string that may contain translations for multiple languages.\n\nIn CDDA JSON, this appears as: ```json { \"str\": \"name\", \"//~\": \"context\" } { \"str_sp\": \"name\" }           // same for singular & plural { \"str_pl\": \"names\" }          // explicit plural ``` Or as a plain string `\"name\"`.\n\nFor Stage 1 we store the raw English text. Full i18n support (extracting translations) is deferred.",
      "anyOf": [
        {
          "description": "A plain, non-localized string.",
          "type": "string"
        },
        {
          "description": "A localized object with optional plural and context.",
          "type": "object",
          "properties": {
            "context": {
              "type": [
                "string",
                "null"
              ]
            },
            "str": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "str_pl": {
              "type": [
                "string",
                "null"
              ]
            },
            "str_sp": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "PracticeData": {
      "description": "Difficulty and skill limit data for a practice recipe.",
      "type": "object",
      "required": [
        "max_difficulty",
        "min_difficulty"
      ],
      "properties": {
        "max_difficulty": {
          "description": "Maximum difficulty level achievable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "min_difficulty": {
          "description": "Minimum required difficulty level.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "skill_limit": {
          "description": "Maximum skill level achievable through this practice.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
}