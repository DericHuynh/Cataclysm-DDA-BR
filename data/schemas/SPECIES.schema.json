{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpeciesDef",
  "description": "A species definition from JSON type `\"SPECIES\"`.\n\nDefines a species category for creatures (e.g. HUMAN, ZOMBIE, MAMMAL, BIRD, INSECT). Species control inter-species aggression, roadkill food preferences, and other behavioral flags.",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "description": {
      "description": "Description text (can be localized).",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/LocalizedString"
        },
        {
          "type": "null"
        }
      ]
    },
    "flags": {
      "description": "Behavioral flags for this species (e.g. \"HUMAN\", \"ZOMBIE\", \"ANIMAL\").",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "description": "Unique identifier (e.g. \"HUMAN\", \"ZOMBIE\", \"MAMMAL\").",
      "allOf": [
        {
          "$ref": "#/definitions/DefId"
        }
      ]
    },
    "name": {
      "description": "Display name (can be localized).",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/LocalizedString"
        },
        {
          "type": "null"
        }
      ]
    },
    "roadkill_food": {
      "description": "Whether creatures of this species are considered roadkill food.",
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "definitions": {
    "DefId": {
      "type": "string"
    },
    "LocalizedString": {
      "description": "A localized string that may contain translations for multiple languages.\n\nIn CDDA JSON, this appears as: ```json { \"str\": \"name\", \"//~\": \"context\" } { \"str_sp\": \"name\" }           // same for singular & plural { \"str_pl\": \"names\" }          // explicit plural ``` Or as a plain string `\"name\"`.\n\nFor Stage 1 we store the raw English text. Full i18n support (extracting translations) is deferred.",
      "anyOf": [
        {
          "description": "A plain, non-localized string.",
          "type": "string"
        },
        {
          "description": "A localized object with optional plural and context.",
          "type": "object",
          "properties": {
            "context": {
              "type": [
                "string",
                "null"
              ]
            },
            "str": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "str_pl": {
              "type": [
                "string",
                "null"
              ]
            },
            "str_sp": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}